# ==============================================================================
# Multi-Category POS & Inventory Management System - Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_inventory_db
DB_USER=postgres
DB_PASSWORD=postgres
# Optional full URI format for deployment (e.g. Render / Supabase / Neon):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_inventory_db

# Authentication / JSON Web Token (JWT)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_pos_2026
JWT_EXPIRES_IN=24h

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880 # 5MB in bytes
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/jpg
