{
  "name": "pos-inventory-backend",
  "version": "1.0.0",
  "description": "Multi-Category POS & Inventory Management System - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node ./node_modules/nodemon/bin/nodemon.js server.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --fix",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write \"**/*.{js,json,md}\"",
    "db:migrate": "node ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "db:migrate:undo": "node ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "db:migrate:undo:all": "node ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo:all",
    "db:seed": "node ./node_modules/sequelize-cli/lib/sequelize db:seed:all",
    "db:seed:undo": "node ./node_modules/sequelize-cli/lib/sequelize db:seed:undo:all",
    "db:reset": "npm run db:migrate:undo:all && npm run db:migrate && npm run db:seed"
  },
  "keywords": [
    "pos",
    "inventory",
    "express",
    "postgresql",
    "sequelize",
    "jwt",
    "retail"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "sequelize-cli": "^6.6.2"
  }
}
